    <Titel id="id9b8d191c-ed8c-4db5-8ae3-5cd71291d3c4">
      <Linea>
        <Char>Bekendtgørelse om ændring af bekendtgørelse om ydelser til lægdommere og vidner mv.</Char>
      </Linea>
    </Titel>
  </TitelGruppe>
  <DokumentIndhold id="id1586ec3e-7565-48d0-b78b-da3716217e59">
    <AendringCentreretParagraf id="id632f8c18-c0af-476d-8fd8-a77a86826935" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I bekendtgørelse nr. 712 af 17. november 1987 om ydelser til lægdommere og vidner mv. som ændret ved bekendtgørelse nr. 613 af 7. juli 1997, bekendtgørelse nr. 1180 af 15. december 2000 og bekendtgørelse nr. 1503 af 14. december 2006, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id34f3ff64-714b-4557-95e8-0569863098e8">
        <Explicatus>1.</Explicatus>
        <Aendring id="id785b687b-1009-4b0e-9a03-3c4093bb0365">
          <AendringDefinition id="idb000d8b3-98a1-4e83-8645-cc69118c20f1">
            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 1, stk. 2,</Char>
                <Char> affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id088bbd76-0d11-4f0a-8185-c832fe8b22a2">
            <AendringNyTekst>
              <Stk id="id1c403f01-5717-4db9-a546-491a6eb548e0">
                <Explicatus>Stk. 2.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Der tilkommer børnesagkyndige dommere, jf. § 148, stk. 1, i barnets lov, og sagkyndige retsmedlemmer 4.200 kr. for hver sag samt 120 kr. for hver nat, de i anledning af deres hverv må være borte fra hjemmet.</Char>
                  </Linea>
                  <Linea>
                    <Char>Hvis behandlingen af en sag strækker sig over flere dage, udgør vederlaget 4.200 kr. for hver dag og 120 kr. for hver nat, de i anledning af deres hverv må være borte fra hjemmet.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="iddb416b62-af99-418b-ad73-5cd04420f601">
        <Explicatus>2.</Explicatus>
        <Aendring id="idbd25b507-3e1b-4441-99e9-00010c1fbc1a">
          <AendringDefinition id="id68c4ecbf-f221-4267-9004-c49f8f3ec6f1">
            <Exitus>
              <Linea>
                <Char>To steder i </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 1, stk. 3, </Char>
                <Char>udgår »og stk. 2«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id934509a9-e916-4509-acf8-49cbcefe0d72">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
    </AendringCentreretParagraf>
    <IkraftCentreretParagraf id="id62097ad8-37cf-4dd2-b9d0-43e119b0086b" localId="2">
      <Explicatus>§ 2</Explicatus>
      <Stk id="id1b070169-ed3a-47a7-94cc-c55cd95b7bc9">
        <Exitus>
          <Linea>
            <Char>Bekendtgørelsen træder i kraft den 15. juni 2024.</Char>
          </Linea>
        </Exitus>
      </Stk>
    </IkraftCentreretParagraf>
