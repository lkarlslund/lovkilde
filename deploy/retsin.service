# Retsin mirror as a user service: the HTML reading UI and the MCP endpoint on one
# port, on every interface. It runs the repository's own build output, the way the
# llama.cpp and ninfer units run theirs, so there is no second copy of the binary that
# can be older than the one just compiled — which is how a deploy once installed a binary
# two weeks stale and reported success. Link this file into place once:
#
#   ln -s ~/github-repos/retsinformation/deploy/retsin.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now retsin.service
#
# After that, deploying is `make deploy`: compile into bin/, refresh the artifact and the
# index when the code that writes them is newer than they are, daemon-reload, restart.
# The unit is a symlink, so an edit to this file needs no copy either.
#
# The compiled files carry the build that wrote them and the reader refuses one from
# another build, because the payload is the JSON form of this repository's Go types. That
# is why a deploy can end with a rebuild of the ~1.6 GB artifact — about a minute, and
# `make deploy` skips it when nothing that writes the artifact has changed. If the
# artifact is stale and the rebuild was skipped, the unit fails at startup naming both
# commits rather than serving text it cannot trust. The search index has no such pin, so
# keeping its provision ids aligned with the artifact's is `make deploy`'s job.
#
# No authentication: this process only ever reads the mirror, so anyone who can reach
# the port can read every document in it and ask the search index anything. That is
# fine on a trusted network and not fine anywhere else; there is no TLS either, so
# put a reverse proxy in front before the port leaves the LAN.
#
# RestartSec is deliberately slow. The server refuses an artifact older than the last
# recorded collection pass, so after a crawl without `retsin artifact build` the unit
# fails at startup. A 30 second gap means the journal keeps one readable reason per
# attempt instead of a hot loop; rebuild the artifact and `systemctl --user restart
# retsin` and it comes back.

[Unit]
Description=Retsin mirror: HTML reading UI and MCP endpoint
Documentation=https://github.com/lkarlslund/retsinformation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github-repos/retsinformation
ExecStart=%h/github-repos/retsinformation/bin/retsin serve --addr 0.0.0.0:8787 --data-dir %h/github-repos/retsinformation/data
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
