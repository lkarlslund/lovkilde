# Lovkilde mirror as a user service: the HTML reading UI and the MCP endpoint on one
# port, on every interface. It runs the repository's own build output, the way the
# llama.cpp and ninfer units run theirs, so there is no second copy of the binary that
# can be older than the one just compiled — which is how a deploy once installed a binary
# two weeks stale and reported success. Link this file into place once:
#
#   ln -s ~/github-repos/retsinformation/deploy/lovkilde.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lovkilde.service
#
# After that, deploying is `make deploy`: compile into bin/, rebuild the artifact with
# lovkilde-update when this build cannot read the one on disk, daemon-reload, restart.
# The unit is a symlink, so an edit to this file needs no copy either.
#
# The server reads the artifact and nothing else: no XML, no state store, no network. The
# artifact carries its document model version and the server refuses another model's,
# because the payload is the JSON form of this repository's Go types; `make deploy` asks
# first and rebuilds the artifact when needed. The search index is the server's own: it
# cuts one from the artifact when there is none or it was cut from another artifact.
#
# No authentication: this process only ever reads the mirror, so anyone who can reach
# the port can read every document in it and ask the search index anything. That is
# fine on a trusted network and not fine anywhere else; there is no TLS either, so
# put a reverse proxy in front before the port leaves the LAN.
#
# With no artifact the server downloads the published one from a release repository
# (--release: a directory, or hf://owner/name; by default the published dataset), and checks
# daily for newer ones and a newer program (--check-every), which it fetches when asked on the
# settings page or through the MCP tool update.
#
# RestartSec is deliberately slow. Without a readable artifact the unit fails at startup;
# a 30 second gap means the journal keeps one readable reason per attempt instead of a
# hot loop. Build one with `lovkilde-update artifact build` (it becomes current, and a
# running server picks a new one up by itself) and the unit comes back.

[Unit]
Description=Lovkilde mirror: HTML reading UI and MCP endpoint
Documentation=https://github.com/lkarlslund/lovkilde
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github-repos/retsinformation
ExecStart=%h/github-repos/retsinformation/bin/lovkilde serve --no-browser --addr 0.0.0.0:8787 --data-dir %h/github-repos/retsinformation/data
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
